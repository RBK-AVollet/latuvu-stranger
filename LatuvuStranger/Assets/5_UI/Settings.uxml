<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="AudioPage" src="project://database/Assets/5_UI/AudioPage.uxml?fileID=9197481963319205126&amp;guid=0f59d9942e0a1c441ac3d2daea5f2641&amp;type=3#AudioPage" />
    <ui:Template name="GraphicsPage" src="project://database/Assets/5_UI/GraphicsPage.uxml?fileID=9197481963319205126&amp;guid=a57d6c5149cc9fe4d97a674621d6977c&amp;type=3#GraphicsPage" />
    <Style src="project://database/Assets/5_UI/Settings.uss?fileID=7433441132597879392&amp;guid=d27e797e634035e42af406f498e2e635&amp;type=3#Settings" />
    <Style src="project://database/Assets/5_UI/GraphicsPage.uss?fileID=7433441132597879392&amp;guid=c2f3646f885dfb94bbee2b86149ff5d7&amp;type=3#GraphicsPage" />
    <Style src="project://database/Assets/5_UI/AudioPage.uss?fileID=7433441132597879392&amp;guid=e0b6efedbe6b4854f96232cabd63030f&amp;type=3#AudioPage" />
    <ui:VisualElement name="root" style="flex-grow: 1; background-color: rgb(0, 0, 0); align-items: center; flex-direction: row;">
        <ui:VisualElement name="settings-mainpage" style="flex-grow: 1; flex-direction: row; justify-content: center; align-self: stretch;">
            <ui:VisualElement name="Container" style="flex-grow: 1; width: 50%; justify-content: center; flex-direction: column; align-self: center; align-items: stretch; height: 100%;">
                <ui:Button name="graphics" class="white Button" style="border-top-width: 0; border-left-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-color: rgba(188, 188, 188, 0); padding-left: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0; padding-right: 0; margin-left: 0; margin-right: 0;">
                    <ui:Label text="GRAPHICS" name="title" style="-unity-text-align: middle-right; font-size: 100px; width: 100%;" />
                </ui:Button>
                <ui:Button name="audio" class="white Button" style="border-top-width: 0; border-left-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-color: rgba(188, 188, 188, 0); padding-left: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0; padding-right: 0; margin-left: 0; margin-right: 0;">
                    <ui:Label text="AUDIO" name="title" style="-unity-text-align: middle-right; font-size: 100px; width: 100%;" />
                </ui:Button>
                <ui:Button name="controls" class="white Button" style="border-top-width: 0; border-left-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-color: rgba(188, 188, 188, 0); padding-left: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0; padding-right: 0; margin-left: 0; margin-right: 0;">
                    <ui:Label text="CONTROLS" name="title" style="-unity-text-align: middle-right; font-size: 100px; width: 100%;" />
                </ui:Button>
                <ui:Button name="language" class="white Button" style="border-top-width: 0; border-left-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-color: rgba(188, 188, 188, 0); padding-left: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0; padding-right: 0; margin-left: 0; margin-right: 0;">
                    <ui:Label text="LANGUAGE" name="title" style="-unity-text-align: middle-right; font-size: 100px; width: 100%;" />
                </ui:Button>
                <ui:Button name="back-button" class="white Button" style="border-top-width: 0; border-left-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-color: rgba(188, 188, 188, 0); padding-left: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0; padding-right: 0; margin-left: 0; margin-right: 0;">
                    <ui:Label text="BACK" name="title" style="-unity-text-align: middle-right; font-size: 100px; width: 100%;" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="image-menu" style="flex-grow: 1; width: 50%; height: 100%; background-size: 80% 80%;" />
        </ui:VisualElement>
        <ui:Instance template="AudioPage" name="audio-page" style="position: absolute; width: 100%; height: 100%; top: -2px; left: 0;" />
        <ui:Instance template="GraphicsPage" name="graphics-page" style="position: absolute; width: 100%; height: 100%;" />
    </ui:VisualElement>
</ui:UXML>
