:root {
}

.unity-label {
    -unity-font-definition: url("project://database/Assets/1_Art/Fonts/Alkhemikal.ttf?fileID=12800000&guid=90aecb5949e6d7a47a8d89b5c0e257bd&type=3#Alkhemikal");
    font-size: 100px;
    color: rgb(164, 164, 164);
}

#root > #Container > #fullscreen > .unity-toggle__label {
    width: 50%;
    -unity-text-align: upper-right;
}

#root > #Container > #resolution > .unity-popup-field__label {
    width: 50%;
    -unity-text-align: upper-right;
}

#root > #Container > #resolution > .unity-popup-field__input {
    background-color: rgba(255, 255, 255, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#root > #Container > #resolution > .unity-popup-field__input > .unity-base-popup-field__text {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    font-size: 100px;
    -unity-font-definition: url("project://database/Assets/1_Art/Fonts/Alkhemikal.ttf?fileID=12800000&guid=90aecb5949e6d7a47a8d89b5c0e257bd&type=3#Alkhemikal");
}

#root > #Container > #resolution > .unity-popup-field__input > .unity-base-popup-field__arrow {
    display: none;
}

#back-button:focus Label#tiltle {
    color: rgb(255, 255, 255);
}
