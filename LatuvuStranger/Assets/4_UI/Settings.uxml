<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/4_UI/Settings.uss?fileID=7433441132597879392&amp;guid=d27e797e634035e42af406f498e2e635&amp;type=3#Settings" />
    <ui:VisualElement name="root" style="flex-grow: 1; background-color: rgb(0, 0, 0); align-items: center;">
        <ui:VisualElement name="Container" style="flex-grow: 1; width: 50%; justify-content: center;">
            <ui:SliderInt label="MASTER" value="42" high-value="10" fill="true" name="volume-slider" style="font-size: 30px; color: rgb(128, 128, 128); align-items: flex-start; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0;" />
            <ui:Toggle label="FULL" name="fullscreen-toggle" style="font-size: 30px; color: rgb(128, 128, 128); margin-top: 0; margin-bottom: 0; margin-left: 0; margin-right: 0;" />
            <ui:Button name="back-button" class="white" style="border-top-width: 0; border-left-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-color: rgba(188, 188, 188, 0); padding-left: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0; padding-right: 0; margin-left: 0; margin-right: 0;">
                <ui:Label text="BACK" name="title" style="-unity-text-align: middle-right; font-size: 100px; width: 50%;" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
