<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Settings" src="project://database/Assets/4_UI/Settings.uxml?fileID=9197481963319205126&amp;guid=d0234a0d467c69d49b39801fa49a2dd9&amp;type=3#Settings" />
    <Style src="project://database/Assets/4_UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=168bfa56a5f9e2c4d9b9c33bafc9894f&amp;type=3#MainMenu" />
    <Style src="project://database/Assets/4_UI/Settings.uss?fileID=7433441132597879392&amp;guid=d27e797e634035e42af406f498e2e635&amp;type=3#Settings" />
    <ui:VisualElement name="root" class="visible" style="flex-grow: 1; background-color: rgb(0, 0, 0); flex-direction: row;">
        <ui:VisualElement name="pause-menu" enabled="true" class="visible" style="flex-grow: 1; flex-direction: row-reverse; width: 100%; visibility: visible;">
            <ui:VisualElement name="Image" style="flex-grow: 1; width: 50%;">
                <ui:VisualElement name="ImageMenu" style="flex-grow: 1; width: 50%; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=7433338533053954386&amp;guid=5df8f2b4aea51664d9649425d3ee5efb&amp;type=3#check@2x&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement name="Buttons" style="flex-grow: 1; flex-direction: column; align-items: auto; justify-content: center; width: 50%;">
                <ui:Button name="resume" class="white Button" style="-unity-text-align: upper-right; width: 100%;">
                    <ui:Label text="RESUME" name="title" enable-rich-text="true" style="flex-direction: column; -unity-text-align: upper-right; -unity-font-style: normal;" />
                </ui:Button>
                <ui:Button name="memories" class="white Button" style="-unity-text-align: upper-right; width: 100%;">
                    <ui:Label text="MEMORIES" name="title" enable-rich-text="true" style="flex-direction: column; -unity-text-align: upper-right; -unity-font-style: normal;" />
                </ui:Button>
                <ui:Button name="settings" class="white Button" style="-unity-text-align: upper-right; width: 100%;">
                    <ui:Label text="SETTINGS" name="title" style="flex-direction: column; -unity-text-align: upper-right;" />
                </ui:Button>
                <ui:Button name="quit" class="white Button" style="-unity-text-align: upper-right; width: 100%;">
                    <ui:Label text="QUIT" name="title" style="flex-direction: column; -unity-text-align: upper-right;" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="Settings" name="settings-menu" class="hidden" style="width: 100%;" />
    </ui:VisualElement>
</ui:UXML>
